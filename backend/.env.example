OPENAI_API_KEY=sk-...
QDRANT_API_KEY=...
QDRANT_HOST=https://your-cluster.qdrant.io
OPENAI_WORKER_MODEL=gpt-4o-mini
OPENAI_STRATEGIST_MODEL=gpt-4o

# Optional: switch web search from DuckDuckGo (default, free, rate-limited)
# to Tavily (structured results with real URLs, more reliable under load).
# Free tier: https://tavily.com
TAVILY_API_KEY=

# Optional: stable secret for signing job access tokens.
# When unset, a random per-process secret is used (tokens won't survive restarts).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=

# Comma-separated allowed CORS origins (production: set to your actual frontend URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Optional: regex matched against the request Origin in addition to
# CORS_ORIGINS. Defaults to matching any Vercel preview URL for the
# sainruthiks-projects/film project, since Vercel mints a new hashed URL on
# every deploy (e.g. film-pojole5vw-sainruthiks-projects.vercel.app) and an
# exact-match list would need updating after every push. Set to a different
# pattern for another Vercel team/project, or blank to disable.
CORS_ORIGIN_REGEX=^https://film-[a-z0-9]+-sainruthiks-projects\.vercel\.app$
