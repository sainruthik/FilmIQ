OPENAI_API_KEY=sk-...
QDRANT_API_KEY=...
QDRANT_HOST=https://your-cluster.qdrant.io
OPENAI_WORKER_MODEL=gpt-4o-mini
OPENAI_STRATEGIST_MODEL=gpt-4o

# Optional: stable secret for signing job access tokens.
# When unset, a random per-process secret is used (tokens won't survive restarts).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=

# Comma-separated allowed CORS origins (production: set to your actual frontend URL)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
